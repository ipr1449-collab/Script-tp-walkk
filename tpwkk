-- [SISTEMA DE DESLIZE IGUAL AO VÍDEO]
runService.Heartbeat:Connect(function()
    if vAtivo then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if root and hum and hum.MoveDirection.Magnitude > 0 then
            -- Aplica a velocidade de TP direto, ignorando se o boneco está em pé ou caído
            -- Para evitar o "peso", o CFrame ignora a fricção do chão
            root.CFrame = root.CFrame + (hum.MoveDirection * intensidade)
        end
    end
end)

-- [Infinite Jump]
userInput.JumpRequest:Connect(function()
    if puloInfinito then
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- [Detector de Ataque]
local function monitorar(char)
    char:WaitForChild("Humanoid").AnimationPlayed:Connect(function(anim)
        if anim.Priority == Enum.AnimationPriority.Action then
            batendo = true
            task.wait(0.7)
            batendo = false
        end
    end)
end
if player.Character then monitorar(player.Character) end
player.CharacterAdded:Connect(monitorar)
